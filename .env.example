# ============================================================
# Renovo Co. CRM — Environment Variables
# ============================================================
# This is a Vanilla JS SPA — environment variables are NOT
# injected at build time. The Supabase URL and anon key are
# embedded directly in index.html (anon key is intentionally public).
#
# HOWEVER, these variables MUST be set as Supabase Edge Function
# Secrets (Dashboard → Project Settings → Edge Functions → Secrets)
# so the server-side functions work correctly.
# ============================================================

# ── Supabase (for reference — embedded in index.html) ────────
# Found in: Supabase Dashboard → Project Settings → API
# These are already embedded in index.html and do NOT need to be set in Vercel.
# SUPABASE_URL=https://qofwwztuykerlcxfuutv.supabase.co
# SUPABASE_ANON_KEY=sb_publishable_SRrLgFY1zPiplYahG6b5nw_oXKzWkVv

# ── Supabase Edge Function Secrets ───────────────────────────
# Set ALL of these in Supabase Dashboard → Project Settings → Edge Functions → Secrets
# These are NOT public — keep them secure.

# Anon key — set as edge function secret (quickbooks-sync, quickbooks-payment-check,
# quickbooks-oauth, and invite-user use it to verify Supabase user sessions)
# Same value as the commented-out SUPABASE_ANON_KEY above.
SUPABASE_ANON_KEY=sb_publishable_SRrLgFY1zPiplYahG6b5nw_oXKzWkVv

# Service role key — used by edge functions to bypass RLS
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── QuickBooks Online OAuth ───────────────────────────────────
# Create an app at: https://developer.intuit.com/app/developer/appdetail
# Under "Keys & credentials" → copy Client ID and Client Secret
# Under "Redirect URIs" → add: https://your-project.supabase.co/functions/v1/quickbooks-callback
QUICKBOOKS_CLIENT_ID=your-quickbooks-client-id
QUICKBOOKS_CLIENT_SECRET=your-quickbooks-client-secret
QUICKBOOKS_REDIRECT_URI=https://qofwwztuykerlcxfuutv.supabase.co/functions/v1/quickbooks-callback

# Your deployed Vercel app URL (used to redirect back after QB OAuth)
APP_URL=https://renovo-co-archive.vercel.app

# ── pg_cron: Automated Overdue Invoice Scan ──────────────────
# The mark-overdue-invoices edge function is called daily by pg_cron.
# pg_cron calls it with your anon key (not a user session), so the
# Supabase database needs to know that key to pass in the Authorization header.
#
# Set this ONE-TIME in Supabase Dashboard → Project Settings → Database
# → Configuration → Custom config (or via SQL):
#   ALTER DATABASE postgres SET "app.anon_key" = '<your-anon-key>';
#
# Without this step the daily cron fires but returns 401, and invoices
# are only marked overdue when an admin manually opens the Dashboard.
# The SUPABASE_ANON_KEY secret above has the value to use here.

# ── Booking Webhook ───────────────────────────────────────────
# Set BOOKING_API_KEY to a strong random secret (e.g. openssl rand -hex 32).
# The booking-webhook edge function requires this key for authentication.
#
# Configure your Zapier/Make/Hospitable zap to send:
#   Authorization: Bearer <BOOKING_API_KEY>
# to: https://qofwwztuykerlcxfuutv.supabase.co/functions/v1/booking-webhook
BOOKING_API_KEY=your-secure-webhook-api-key-min-32-chars
